# inicio-faucet config. Copy to `faucet.toml` (gitignored) and fill in.
#
#   cp faucet.toml.example faucet.toml
#
# Produce the four .mac files first:
#   inicio-faucet create-faucet --symbol TOKA --name "Token A" --decimals 8 \
#       --max-supply 1000000000000 --out ./faucets/toka.mac
# (repeat for TOKB / TOKC / TOKD), then reference them below.
#
# Testnet charges transaction fees in native MIDEN, paid from each faucet's own
# vault. On start, the service registers each undeployed faucet with the network;
# a network that funds registrations then sends it a MIDEN note, and the service
# deploys the faucet by consuming it. On a network that doesn't, send some MIDEN
# (e.g. from the official testnet faucet) to each address `create-faucet` prints.
# Until a faucet is funded, mints for it answer 503 with its address.

[rpc]
# Miden node gRPC endpoint. Testnet runs the 0.17 protocol this client speaks.
endpoint = "https://rpc.testnet.miden.io"
timeout_ms = 10000
# Optional: offload STARK proving to a remote prover (much less CPU on this host).
# Omit to prove locally.
# remote_prover_url = "https://tx-prover.testnet.miden.io"

[server]
bind = "127.0.0.1:8080"
max_batch_size = 256        # max notes minted per tx; bursts coalesce while proving
static_dir = "static"       # frontend directory served by the same binary

[[tokens]]
symbol = "TOKA"
name = "Token A"
decimals = 8
account_file = "./faucets/toka.mac"
store_path = "./faucets/toka.sqlite3"
keystore_path = "./faucets/toka_keystore"
# Optional: cap the amount mintable per request (base units). Omit for uncapped.
# max_mint_amount = 100000000000
# Optional: invitation code to register the faucet with (one code per account).
# Only needed on a network that enforces an account allowlist; testnet doesn't.
# invitation_code = "..."

[[tokens]]
symbol = "TOKB"
name = "Token B"
decimals = 8
account_file = "./faucets/tokb.mac"
store_path = "./faucets/tokb.sqlite3"
keystore_path = "./faucets/tokb_keystore"

[[tokens]]
symbol = "TOKC"
name = "Token C"
decimals = 8
account_file = "./faucets/tokc.mac"
store_path = "./faucets/tokc.sqlite3"
keystore_path = "./faucets/tokc_keystore"

[[tokens]]
symbol = "TOKD"
name = "Token D"
decimals = 8
account_file = "./faucets/tokd.mac"
store_path = "./faucets/tokd.sqlite3"
keystore_path = "./faucets/tokd_keystore"
